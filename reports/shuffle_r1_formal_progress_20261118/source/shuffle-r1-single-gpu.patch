+
+    def test_rejects_insufficient_abs_pair_pool(self):
+        with self.assertRaises(ValueError):
+            derive_batch_geometry(1, 128)
+
+
+    def test_abs_requires_sufficient_positive_support(self):
+        self.assertEqual(validate_abs_support([0, 1, 2, 0, 3], 3), 3)
+        with self.assertRaisesRegex(ValueError, "positive support 2"):
+            validate_abs_support([0, 1, 2, 0, 0], 3)
+        with self.assertRaisesRegex(ValueError, "zero total mass"):
+            validate_abs_support([0, 0, 0], 1)
