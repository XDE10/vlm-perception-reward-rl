@@ -0,0 +1,66 @@
+from io import BytesIO
+
+from PIL import Image
+
+from verl.utils.dataset import ImageProcessMixin
+
+
+class ImageProcessor(ImageProcessMixin):
+    max_pixels = 100_000
+    min_pixels = 1
+
+
+def encode(image):
+    stream = BytesIO()
+    image.save(stream, format="PNG")
+    return stream.getvalue()
+
+
+def test_rgba_transparent_diagram_is_composited_over_white():
+    image = Image.new("RGBA", (8, 8), (0, 0, 0, 0))
+    image.putpixel((3, 3), (0, 0, 0, 255))
+    result = ImageProcessor().process_image({"bytes": encode(image)})
+
+    assert result.mode == "RGB"
+    assert result.getpixel((0, 0)) == (255, 255, 255)
+    assert result.getpixel((3, 3)) == (0, 0, 0)
+
+
+def test_rgba_partial_alpha_is_blended_against_white():
+    image = Image.new("RGBA", (4, 4), (0, 0, 0, 0))
+    image.putpixel((1, 1), (0, 0, 0, 128))
+    result = ImageProcessor().process_image({"bytes": encode(image)})
+
+    pixel = result.getpixel((1, 1))
+    assert 126 <= pixel[0] <= 128
+    assert pixel[0] == pixel[1] == pixel[2]
+    assert result.getpixel((0, 0)) == (255, 255, 255)
+
+
+def test_palette_transparency_is_composited_over_white():
+    image = Image.new("P", (4, 4), 0)
+    palette = [0, 0, 0] * 256
+    palette[3:6] = [0, 0, 0]
+    image.putpalette(palette)
+    image.putpixel((2, 2), 1)
+    image.info["transparency"] = 0
+    result = ImageProcessor().process_image({"bytes": encode(image)})
+
+    assert result.mode == "RGB"
+    assert result.getpixel((0, 0)) == (255, 255, 255)
+    assert result.getpixel((2, 2)) == (0, 0, 0)
+
+
+def test_la_transparency_is_composited_over_white():
+    image = Image.new("LA", (4, 4), (0, 0))
+    image.putpixel((1, 1), (0, 255))
+    result = ImageProcessor().process_image({"bytes": encode(image)})
+
+    assert result.getpixel((0, 0)) == (255, 255, 255)
+    assert result.getpixel((1, 1)) == (0, 0, 0)
+
+
+def test_opaque_rgb_image_is_unchanged():
+    image = Image.new("RGB", (4, 4), (12, 34, 56))
+    result = ImageProcessor().process_image({"bytes": encode(image)})
+    assert result.getpixel((0, 0)) == (12, 34, 56)
