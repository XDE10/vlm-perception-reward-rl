+
+REVISION = "66285546d2b821cf421d4f5eb2576359d3770cd3"
+
+
+def cli_overrides(prompts=16, actor_batch=16, chunk=8, selection="pairwise", replay=True):
+    return [
+        "config=examples/config.yaml", "trainer.n_gpus_per_node=1",
+        "worker.actor.model.model_path=Qwen/Qwen2.5-VL-3B-Instruct",
+        "worker.actor.model.freeze_vision_tower=true",
+        "algorithm.adv_estimator=pairwise_purning", "algorithm.kl_coef=0.0",
+        f"data.rollout_batch_size={prompts}", f"worker.actor.global_batch_size={actor_batch}",
+        "worker.rollout.n=16", "worker.rollout.tensor_parallel_size=1",
+        f"worker.rollout.rollout_chunk_prompts={chunk}", "worker.actor.purning_ratio=0.5",
+        "worker.actor.micro_batch_size_per_device_for_update=1",
+        "trainer.reference_data_parallel_size=8", "trainer.reference_micro_batch_size=4",
+        "worker.actor.reference_micro_batch_size_for_update=4",
+        f"trainer.selection_mode={selection}", f"trainer.experience_replay={str(replay).lower()}",
+        "trainer.require_checkpoint_manifest=true", f"trainer.checkpoint_model_revision={REVISION}",
+    ]
+
+
+@pytest.mark.parametrize("prompts,actor_batch,chunk,steps", [(16, 16, 8, 1), (128, 128, 16, 1),
+                                                            (512, 128, 16, 4), (64, 32, 16, 2)])
+def test_parse_real_config_and_preserve_optimizer_steps(prompts, actor_batch, chunk, steps):
+    config = main.load_config(cli_overrides(prompts, actor_batch, chunk))
+    assert config.worker.rollout.rollout_chunk_prompts == chunk
+    assert config.worker.rollout.require_rng_checkpoint and config.worker.actor.fail_on_nonfinite_update
+    assert config.worker.actor.model.revision == REVISION
+    assert config.algorithm.adv_estimator == "pairwise_purning" and not config.algorithm.disable_kl
+    assert config.trainer.reference_data_parallel_size == 8
+    assert config.trainer.reference_micro_batch_size == config.worker.actor.reference_micro_batch_size_for_update == 4
+    assert derive_batch_geometry(prompts, actor_batch).optimizer_steps_per_outer_step == steps
