+def test_fit_stops_after_verified_update_and_resumes_next_batch(checkpoint_setup, monkeypatch):
+    root, make_trainer, _ = checkpoint_setup
+    seen = []
+    monkeypatch.setattr(ray_trainer, "Tracker", lambda **_: SimpleNamespace(log=lambda **_: None))
+    for name in ("compute_data_metrics", "compute_timing_metrics", "compute_throughout_metrics"):
+        monkeypatch.setattr(ray_trainer, name, lambda **_: {})
+
+    def prepare(load=None, stop=None):
+        trainer = make_trainer(load)
+        cfg = trainer.config
+        cfg.trainer.max_steps = trainer.training_steps = 3
+        cfg.trainer.stop_after_step = stop
+        cfg.trainer.save_freq = -1
+        cfg.worker.rollout.n = 1
+        cfg.algorithm.use_kl_loss = True
+        trainer.val_reward_fn = None
+        trainer.use_reward_model = trainer.use_reference_policy = False
+        trainer.resource_pool_manager = SimpleNamespace(get_n_gpus=lambda: 1)
+        trainer._balance_batch = lambda *_args, **_kwargs: None
+
+        def collate(batch):
+            tokens = torch.tensor([[x + 5, 11] for x in batch])
+            raw = np.empty(len(batch), dtype=object)
+            raw[:] = tokens.tolist()
+            return {"raw_prompt_ids": raw, "input_ids": tokens, "attention_mask": torch.ones_like(tokens),
+                    "position_ids": torch.arange(2).expand(len(batch), -1)}
+
+        trainer.train_dataloader = StatefulDataLoader(list(range(5)), batch_size=1, collate_fn=collate,
+                                                       generator=torch.Generator().manual_seed(3))
+        worker = trainer.actor_rollout_wg
+
+        def generate(prompts):
+            seen.append(int(prompts.batch["input_ids"][0, 0]))
+            result = DataProto.from_dict(tensors={"responses": torch.ones(len(prompts), 1, dtype=torch.long),
+               "response_mask": torch.ones(len(prompts), 1, dtype=torch.long),
+               "attention_mask": prompts.batch["attention_mask"]}, meta_info=dict(prompts.meta_info))
+            return result
+
+        def update(_batch):
+            worker.checkpoint_manager.update()
+            return SimpleNamespace(non_tensor_batch={"actor/optimizer_steps": [1], "actor/scheduler_steps": [1]})
+
+        trainer.reward_fn = lambda b: (torch.ones(len(b), 1), {})
+        worker.generate_sequences = generate
+        worker.compute_log_probs = lambda b: DataProto.from_dict(tensors={"old_log_probs": torch.zeros(len(b), 1)})
+        worker.update_actor = update
+        return trainer
+
+    paused = prepare(stop=2)
+    paused.fit()
+    checkpoint = root / "global_step_2"
+    assert (paused.global_step, paused.optimizer_steps, paused.scheduler_steps) == (2, 2, 2)
+    assert verify_manifest(checkpoint, paused.checkpoint_identity, 2)["optimizer_steps"] == 2
+    assert seen == [5, 6]
+    resumed = prepare(checkpoint)
+    resumed.fit()
+    assert seen == [5, 6, 7]
+    assert (resumed.global_step, resumed.optimizer_steps, resumed.scheduler_steps) == (3, 3, 3)
+    assert (root / ray_trainer.CHECKPOINT_TRACKER).read_text() == "3"
