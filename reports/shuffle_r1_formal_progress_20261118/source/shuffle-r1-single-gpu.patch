+    capture_driver_rng_state,
+    next_logical_step,
+    restore_driver_rng_state,
+    validate_abs_support,
+)
+
+
+def make_group_batch(group_count, positive_groups=()):
+    rewards = torch.zeros((group_count * 16, 1), dtype=torch.float32)
+    for group in positive_groups:
+        rewards[group * 16, 0] = 1.0
+    uids = np.repeat(np.asarray([f"q{index}" for index in range(group_count)], dtype=object), 16)
+    return DataProto.from_dict(
+        tensors={
+            "token_level_rewards": rewards,
+            "response_mask": torch.ones_like(rewards),
+        },
+        non_tensors={"uid": uids, "source_row": np.arange(group_count * 16)},
+        meta_info={"temperature": 1.0},
+    )
+
+
+class SingleGpuSemanticTests(unittest.TestCase):
+    def test_author_pts_pair_order_and_retained_extremes(self):
+        rewards = torch.arange(16, dtype=torch.float32).reshape(16, 1)
+        mask = torch.ones_like(rewards)
+        _, _, pairs = compute_pairwise_purning_grpo_advantage(
+            rewards, mask, np.asarray(["one_prompt"] * 16, dtype=object),
+            purning=True, purning_ratio=0.5, selection_mode="pairwise",
+        )
+        self.assertEqual([item["pair_index"] for item in pairs], [[15, 0], [14, 1], [13, 2], [12, 3]])
+
+    def test_pts_and_uniform_ablation_return_original_row_order(self):
+        data = make_group_batch(3, positive_groups=(0, 1, 2))
+        np.random.seed(17)
+        pts = compute_advantage(
+            data, AdvantageEstimator.PAIRWISE_PURNING,
+            purning_ratio=0.5, experience_replay=False, selection_mode="pairwise",
+        )
+        uniform_rng = np.random.default_rng(17)
+        uniform = compute_advantage(
+            data, AdvantageEstimator.PAIRWISE_PURNING,
+            purning_ratio=0.5, experience_replay=False, selection_mode="uniform",
+            selection_rng=uniform_rng,
+        )
+        self.assertEqual(np.random.rand(), np.random.RandomState(17).rand())
+        for selected in (pts, uniform):
+            rows = selected.non_tensor_batch["source_row"].tolist()
+            self.assertEqual(rows, sorted(rows))
+            self.assertEqual(len(rows), 24)
+            self.assertEqual(len(set(rows)), 24)
+            self.assertEqual([sum(row // 16 == group for row in rows) for group in range(3)], [8, 8, 8])
+        self.assertEqual(
+            pts.non_tensor_batch["source_row"].tolist(),
+            [0, 1, 2, 3, 12, 13, 14, 15,
+             16, 17, 18, 19, 28, 29, 30, 31,
+             32, 33, 34, 35, 44, 45, 46, 47],
+        )
+
+    def test_abs_full_pool_produces_exact_author_batch(self):
+        data = make_group_batch(512, positive_groups=range(512))
+        pair_pool = compute_advantage(
+            data, AdvantageEstimator.PAIRWISE_PURNING,
+            purning_ratio=0.5, experience_replay=True, selection_mode="pairwise",
+        )
+        trainer = object.__new__(RayPPOTrainer)
+        trainer.config = SimpleNamespace(
+            data=SimpleNamespace(rollout_batch_size=512),
+            worker=SimpleNamespace(
+                actor=SimpleNamespace(global_batch_size=128, purning_ratio=0.5),
+                rollout=SimpleNamespace(n=16),
+            ),
+            trainer=SimpleNamespace(
+                replay_times=8, sampling_method="power", sampling_weight="sum", sampling_coeff=1,
+            ),
+        )
+        trainer.global_step = 1
+        trainer.training_steps = 80
+        np.random.seed(1234)
+        output = trainer.experience_resampling(pair_pool)
+        self.assertEqual(len(pair_pool), 2048)
+        self.assertEqual(len(output), 4096)
+        self.assertEqual(output.batch["token_level_rewards"].shape, (4096, 1))
+
+    def test_abs_positive_support_boundary_252_fails_256_passes(self):
+        for positive_groups, expected_support in ((63, 252), (64, 256)):
+            data = make_group_batch(512, positive_groups=range(positive_groups))
+            _, _, pairs = compute_pairwise_purning_grpo_advantage(
+                data.batch["token_level_rewards"], data.batch["response_mask"],
+                data.non_tensor_batch["uid"], purning=True, purning_ratio=0.5,
+            )
+            weights = np.asarray([pair["adv_sum"] for pair in pairs], dtype=float)
+            self.assertEqual(int(np.count_nonzero(weights > 0)), expected_support)
+            if expected_support < 256:
+                with self.assertRaisesRegex(ValueError, "positive support 252"):
+                    validate_abs_support(weights, 256)
+            else:
+                self.assertEqual(validate_abs_support(weights, 256), 256)
+
+    def test_driver_rng_round_trip_reproduces_next_draws(self):
+        random.seed(91)
+        np.random.seed(91)
+        torch.manual_seed(91)
+        state = capture_driver_rng_state()
+        expected = (random.random(), np.random.random(5), torch.rand(5))
+        restore_driver_rng_state(state)
+        actual = (random.random(), np.random.random(5), torch.rand(5))
+        self.assertEqual(expected[0], actual[0])
+        np.testing.assert_array_equal(expected[1], actual[1])
+        torch.testing.assert_close(expected[2], actual[2], rtol=0, atol=0)
+
+    def test_logical_step_does_not_overshoot_limit(self):
+        self.assertEqual(next_logical_step(0, 2), 1)
+        self.assertEqual(next_logical_step(1, 2), 2)
+        self.assertIsNone(next_logical_step(2, 2))
+        self.assertIsNone(next_logical_step(0, 0))
+
+    def test_rollout_chunk_concat_preserves_rows_and_metadata(self):
+        source = DataProto.from_dict(
+            tensors={"tokens": torch.arange(64).reshape(16, 4)},
+            non_tensors={"sample_id": np.arange(16)},
+            meta_info={"temperature": 1.0, "policy_version": "theta-0"},
+        )
+        merged = DataProto.concat(source.chunk(4))
+        torch.testing.assert_close(merged.batch["tokens"], source.batch["tokens"])
+        np.testing.assert_array_equal(merged.non_tensor_batch["sample_id"], source.non_tensor_batch["sample_id"])
+        self.assertEqual(merged.meta_info, source.meta_info)
+
+
+if __name__ == "__main__":
+    unittest.main()
