new file mode 100644
index 0000000..6634cf7
--- /dev/null
+++ b/verl/utils/image_processing.py
@@ -0,0 +1,26 @@
+"""Shared white-background image preprocessing for training and evaluation."""
+import math
+
+from PIL import Image
+
+
+def image_size(width: int, height: int, min_pixels: int, max_pixels: int) -> tuple[int, int]:
+    area = width * height
+    if area > max_pixels or area < min_pixels:
+        limit = max_pixels if area > max_pixels else min_pixels
+        factor = math.sqrt(limit / area)
+        width, height = int(width * factor), int(height * factor)
+        if min(width, height) < 1:
+            raise ValueError("image is too narrow to resize under the configured pixel budget")
+    return width, height
+
+
+def prepare_image(image: Image.Image, min_pixels: int, max_pixels: int) -> Image.Image:
+    if image.mode == "P" or "A" in image.getbands() or "transparency" in image.info:
+        rgba = image.convert("RGBA")
+        background = Image.new("RGBA", rgba.size, (255, 255, 255, 255))
+        image = Image.alpha_composite(background, rgba).convert("RGB")
+    elif image.mode != "RGB":
+        image = image.convert("RGB")
+    size = image_size(*image.size, min_pixels, max_pixels)
+    return image.resize(size) if size != image.size else image
