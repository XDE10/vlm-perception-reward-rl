+            reference_micro_batch_size=4,
+        )
+        self.assertEqual(len(order), 4096)
+        self.assertEqual(order[:32], list(range(0, 4)) + list(range(512, 516)) +
+                         list(range(1024, 1028)) + list(range(1536, 1540)) +
+                         list(range(2048, 2052)) + list(range(2560, 2564)) +
+                         list(range(3072, 3076)) + list(range(3584, 3588)))
+        self.assertEqual(len(set(order)), 4096)
+
+    def test_reference_microbatch_token_weighting(self):
+        weights = reference_token_weights([1, 3, 2, 6, 4, 4, 0, 8], 4)
+        self.assertAlmostEqual(sum(weights[:4]), 1.0)
+        self.assertAlmostEqual(weights[0], 1 / 12)
+        self.assertAlmostEqual(weights[3], 6 / 12)
+        self.assertAlmostEqual(sum(weights[4:]), 1.0)
+
+    def test_reference_layout_rejects_partial_rank(self):
+        with self.assertRaises(ValueError):
+            reference_layout_indices(10, 2, 5, 4, 2)
+
+
+if __name__ == "__main__":
+    unittest.main()
