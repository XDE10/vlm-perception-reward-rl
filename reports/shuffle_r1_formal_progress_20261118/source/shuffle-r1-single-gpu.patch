+class BatchGeometryTests(unittest.TestCase):
+    def test_author_3b_shape_on_eight_gpus(self):
+        shape = derive_batch_geometry(512, 128, world_size=8, micro_batch_size=4)
+        self.assertEqual(shape.candidate_rows, 8192)
+        self.assertEqual(shape.kept_rows, 4096)
+        self.assertEqual(shape.actor_batch_per_rank, 128)
+        self.assertEqual(shape.kept_rows_per_rank, 512)
+        self.assertEqual(shape.optimizer_steps_per_outer_step, 4)
+        self.assertEqual(shape.micro_batches_per_optimizer_step, 32)
+        self.assertEqual(shape.abs_pairs, 2048)
+        self.assertEqual(shape.abs_pairs_per_replay, 256)
+        self.assertFalse(shape.partial_actor_batch)
+
+    def test_single_gpu_logical_512_preserves_optimizer_step_count(self):
+        shape = derive_batch_geometry(512, 128, world_size=1, micro_batch_size=1)
+        self.assertEqual(shape.actor_batch_per_rank, 1024)
+        self.assertEqual(shape.kept_rows_per_rank, 4096)
+        self.assertEqual(shape.optimizer_steps_per_outer_step, 4)
+        self.assertEqual(shape.micro_batches_per_optimizer_step, 1024)
+        self.assertEqual(shape.abs_pairs, 2048)
+        self.assertEqual(shape.abs_pairs_per_replay, 256)
+
+    def test_existing_g4_smoke_is_one_optimizer_step(self):
+        shape = derive_batch_geometry(16, 16, world_size=1, micro_batch_size=1)
+        self.assertEqual(shape.kept_rows, 128)
+        self.assertEqual(shape.actor_batch_per_rank, 128)
+        self.assertEqual(shape.optimizer_steps_per_outer_step, 1)
+        self.assertEqual(shape.abs_pairs, 64)
+        self.assertEqual(shape.abs_pairs_per_replay, 8)
+
+    def test_pts_ablation_shape_is_two_optimizer_steps(self):
+        shape = derive_batch_geometry(64, 32, world_size=1, micro_batch_size=1)
+        self.assertEqual(shape.kept_rows, 512)
+        self.assertEqual(shape.actor_batch_per_rank, 256)
+        self.assertEqual(shape.optimizer_steps_per_outer_step, 2)
+        self.assertEqual(shape.abs_pairs_per_replay, 32)
+
+    def test_rejects_non_integer_retained_rollouts(self):
