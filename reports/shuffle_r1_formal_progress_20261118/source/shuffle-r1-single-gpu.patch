+from types import MethodType
+
+import pytest
+import torch
+from torch import nn
+
+from shuffle_r1.single_gpu import reference_layout_indices
+from verl.protocol import DataProto
+from verl.trainer.core_algos import compute_policy_loss_v2
+from verl.workers.actor.config import ActorConfig
+from verl.workers.actor.dp_actor import DataParallelPPOActor
+
+
+@pytest.fixture
+def cpu_device(monkeypatch):
+    monkeypatch.setattr(torch.cuda, "current_device", lambda: torch.device("cpu"))
+
+
+def actor_model():
+    model = nn.Linear(3, 1, bias=False, dtype=torch.float64)
+    model.weight.data.copy_(torch.tensor([[0.21, -0.37, 0.48]], dtype=torch.float64))
+    return model
+
+
+def scores(model, inputs, temperature):
+    return model(inputs["input_ids"]).squeeze(-1) / temperature
+
+
+def make_batch(size):
+    rng = torch.Generator().manual_seed(112)
+    length = 6
+    ids = torch.randn(size, length, 3, generator=rng, dtype=torch.float64)
+    mask = (torch.arange(length)[None, :] < torch.arange(size)[:, None] % length + 1).to(torch.float64)
+    advantages = torch.randn(size, length, generator=rng, dtype=torch.float64)
+    tensors = {"input_ids": ids, "responses": torch.zeros_like(mask, dtype=torch.long),
+               "position_ids": torch.arange(length).repeat(size, 1), "attention_mask": mask,
+               "advantages": advantages}
+    return DataProto.from_dict(tensors=tensors, meta_info={"temperature": 1.0})
+
+
+def run_reference(model, optimizer, data, rank_count, per_rank_update, micro):
+    per_rank = len(data) // rank_count
+    norms, losses = [], []
+    for start in range(0, per_rank, per_rank_update):
+        micro_losses = []
+        for rank in range(rank_count):
+            base = rank * per_rank + start
+            for offset in range(0, per_rank_update, micro):
+                rows = data[base + offset:base + offset + micro].batch
+                value = compute_policy_loss_v2(
+                    rows["old_log_probs"], scores(model, rows, 1.0), rows["advantages"],
+                    rows["attention_mask"], cliprange=0.2,
+                )[0]
+                micro_losses.append(value)
+        loss = torch.stack(micro_losses).mean()
+        loss.backward()
+        norms.append(nn.utils.clip_grad_norm_(model.parameters(), 0.03).item())
+        losses.append(loss.item())
+        optimizer.step()
+        optimizer.zero_grad()
+    return norms, losses
