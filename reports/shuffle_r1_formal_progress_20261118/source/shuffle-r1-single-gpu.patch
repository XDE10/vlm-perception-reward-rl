+def test_actual_actor_matches_eight_rank_fixed_trajectory_adamw(cpu_device):
+    ranks, rank_rows, rank_update, micro = 8, 32, 8, 4
+    source, serial_model = actor_model(), actor_model()
+    opt_ref = torch.optim.AdamW(source.parameters(), lr=0.21)
+    opt_serial = torch.optim.AdamW(serial_model.parameters(), lr=0.21)
+    config = ActorConfig(micro_batch_size_per_device_for_update=1,
+                         micro_batch_size_per_device_for_experience=4,
+                         reference_micro_batch_size_for_update=micro,
+                         max_grad_norm=0.03, use_torch_compile=False)
+    config.global_batch_size_per_device = ranks * rank_update
+    config.fail_on_nonfinite_update = True
+    actor = DataParallelPPOActor(config, serial_model, opt_serial)
+    actor.rank = 1
+    actor._forward_micro_batch = MethodType(
+        lambda self, values, temperature: (scores(self.actor_module, values, temperature), None), actor
+    )
+    data = make_batch(ranks * rank_rows)
+    with torch.no_grad():
+        frozen = scores(source, data.batch, 1.0)
+    prediction = actor.compute_log_prob(data)
+    torch.testing.assert_close(prediction, frozen, atol=1e-12, rtol=1e-12)
+    data.batch["old_log_probs"] = prediction
+    norms, _ = run_reference(source, opt_ref, data, ranks, rank_update, micro)
+    order = reference_layout_indices(len(data), ranks, rank_rows, rank_update, micro)
+    data.reorder(torch.tensor(order))
+    metrics = actor.update_policy(data)
+    assert metrics["actor/optimizer_steps"] == 4
+    torch.testing.assert_close(torch.tensor(metrics["actor/grad_norm"]), torch.tensor(norms), atol=1e-7, rtol=1e-6)
+    assert any(norm > config.max_grad_norm for norm in norms)
+    torch.testing.assert_close(serial_model.weight, source.weight, atol=2e-10, rtol=2e-9)
+    for key, value in opt_ref.state[source.weight].items():
+        torch.testing.assert_close(opt_serial.state[serial_model.weight][key], value, atol=2e-10, rtol=2e-9)
+
+
+def test_strict_nonfinite_update_raises_without_stepping():
+    model = actor_model()
+    optimizer = torch.optim.AdamW(model.parameters(), lr=0.2)
+    config = ActorConfig(use_torch_compile=False)
+    config.fail_on_nonfinite_update = True
+    actor = DataParallelPPOActor(config, model, optimizer)
+    model.weight.grad = torch.full_like(model.weight, float("nan"))
+    with pytest.raises(RuntimeError, match="Non-finite actor gradient"):
+        actor._optimizer_step()
+    assert not optimizer.state and model.weight.grad is None
