@@ -0,0 +1,165 @@
+import json
+import sys
+from types import SimpleNamespace
+
+import numpy as np
+from omegaconf.errors import ConfigKeyError
+import pytest
+import torch
+
+from shuffle_r1 import main
+from shuffle_r1.fsdp import FSDPWorker
+from shuffle_r1.single_gpu import derive_batch_geometry
+from verl.protocol import DataProto
+
+
+REVISION = "66285546d2b821cf421d4f5eb2576359d3770cd3"
+
+
+def cli_overrides(prompts=16, actor_batch=16, chunk=8, selection="pairwise", replay=True):
+    return [
+        "config=examples/config.yaml", "trainer.n_gpus_per_node=1",
+        "worker.actor.model.model_path=Qwen/Qwen2.5-VL-3B-Instruct",
+        "worker.actor.model.freeze_vision_tower=true",
+        "algorithm.adv_estimator=pairwise_purning", "algorithm.kl_coef=0.0",
+        f"data.rollout_batch_size={prompts}", f"worker.actor.global_batch_size={actor_batch}",
+        "worker.rollout.n=16", "worker.rollout.tensor_parallel_size=1",
+        f"worker.rollout.rollout_chunk_prompts={chunk}", "worker.actor.purning_ratio=0.5",
+        "worker.actor.micro_batch_size_per_device_for_update=1",
+        "trainer.reference_data_parallel_size=8", "trainer.reference_micro_batch_size=4",
+        "worker.actor.reference_micro_batch_size_for_update=4",
+        f"trainer.selection_mode={selection}", f"trainer.experience_replay={str(replay).lower()}",
+        "trainer.require_checkpoint_manifest=true", f"trainer.checkpoint_model_revision={REVISION}",
+    ]
+
+
+@pytest.mark.parametrize("prompts,actor_batch,chunk,steps", [(16, 16, 8, 1), (128, 128, 16, 1),
+                                                            (512, 128, 16, 4), (64, 32, 16, 2)])
+def test_parse_real_config_and_preserve_optimizer_steps(prompts, actor_batch, chunk, steps):
+    config = main.load_config(cli_overrides(prompts, actor_batch, chunk))
+    assert config.worker.rollout.rollout_chunk_prompts == chunk
+    assert config.worker.rollout.require_rng_checkpoint and config.worker.actor.fail_on_nonfinite_update
+    assert config.worker.actor.model.revision == REVISION
+    assert config.algorithm.adv_estimator == "pairwise_purning" and not config.algorithm.disable_kl
+    assert config.trainer.reference_data_parallel_size == 8
+    assert config.trainer.reference_micro_batch_size == config.worker.actor.reference_micro_batch_size_for_update == 4
+    assert derive_batch_geometry(prompts, actor_batch).optimizer_steps_per_outer_step == steps
+
+
+def test_config_print_uses_real_entry_without_ray_start(monkeypatch, capsys):
+    monkeypatch.setattr(sys, "argv", ["shuffle_r1.main", "--print-config", *cli_overrides()])
+    monkeypatch.setattr(main.ray, "init", lambda **_: pytest.fail("CPU config print started Ray"))
+    main.main()
+    parsed = json.loads(capsys.readouterr().out)
+    assert parsed["worker"]["rollout"]["rollout_chunk_prompts"] == 8
+    assert main.FSDPWorker is FSDPWorker
+
+
+def test_config_rejects_old_key_and_incompatible_ablation():
+    with pytest.raises(ConfigKeyError):
+        main.load_config([*cli_overrides(), "trainer.rollout_chunk_prompts=8"])
+    with pytest.raises(ValueError, match="disable ABS"):
+        main.load_config(cli_overrides(selection="uniform"))
+    with pytest.raises(ValueError, match="divisible"):
+        main.load_config(cli_overrides(chunk=5))
+
+
+class RolloutContext:
+    def __init__(self):
+        self.events = []
+
+    def __enter__(self):
+        self.events.append("sync")
+
+    def __exit__(self, *_):
+        self.events.append("sleep")
+
+    def preprocess_data(self, prompts):
+        return prompts
+
+    def postprocess_data(self, output):
+        return output
+
+
+def fake_prompts(count):
+    images = np.empty(count, dtype=object)
+    for i in range(count):
+        images[i] = {"pixel_values": torch.tensor([[float(i)]]), "image_grid_thw": torch.tensor([1, 1, 1])}
+    return DataProto.from_dict(
+        tensors={"input_ids": torch.arange(count * 3).reshape(count, 3),
+                 "position_ids": torch.arange(count * 9).reshape(count, 3, 3),
+                 "attention_mask": torch.ones(count, 3, dtype=torch.long)},
+        non_tensors={"multi_modal_inputs": images, "multi_modal_data": images.copy(),
+                     "raw_prompt_ids": np.arange(count), "sample_id": np.arange(count),
+                     "answer": np.asarray([f"answer-{i}" for i in range(count)], dtype=object)},
+        meta_info={"policy_version": 7, "n": 2},
+    )
+
+
+@pytest.mark.parametrize("count,chunk_sizes", [(16, [8, 8]), (10, [8, 2])])
+def test_actual_worker_chunks_one_policy_and_matches_full_rollout(count, chunk_sizes):
+    def run(chunk):
+        manager = RolloutContext()
+        sizes = []
+
+        def generate(*, prompts):
+            assert manager.events == ["sync"]
+            sizes.append(len(prompts))
+            assert prompts.meta_info["policy_version"] == 7
+            np.testing.assert_array_equal(prompts.non_tensor_batch.pop("raw_prompt_ids"),
+                                          prompts.non_tensor_batch["sample_id"])
+            assert len(prompts.non_tensor_batch.pop("multi_modal_data")) == len(prompts)
+            output = prompts.repeat(repeat_times=2, interleave=True)
+            output.meta_info = {}  # vLLM returns a fresh DataProto without input metadata.
+            output.batch["responses"] = torch.stack([
+                torch.tensor([int(i), j]) for i in prompts.non_tensor_batch["sample_id"] for j in range(2)
+            ])
+            output.batch["response_mask"] = torch.ones_like(output.batch["responses"])
+            return output
+
+        worker = SimpleNamespace(
+            _is_rollout=True, _use_param_offload=False, _use_optimizer_offload=False,
+            generation_config=None, tokenizer=SimpleNamespace(eos_token_id=2, pad_token_id=0),
+            config=SimpleNamespace(rollout=SimpleNamespace(rollout_chunk_prompts=chunk, n=16)),
+            rollout_sharding_manager=manager, rollout=SimpleNamespace(generate_sequences=generate),
+        )
+        output = main.FSDPWorker.generate_sequences(worker, fake_prompts(count))
+        assert manager.events == ["sync", "sleep"]
+        return output, sizes
+
+    full, sizes = run(0)
+    chunked, actual_chunks = run(8)
+    assert sizes == [count] and actual_chunks == chunk_sizes
+    assert chunked.meta_info["policy_version"] == 7
+    for key in full.batch.keys():
+        torch.testing.assert_close(chunked.batch[key], full.batch[key], rtol=0, atol=0)
+    np.testing.assert_array_equal(chunked.non_tensor_batch["sample_id"], full.non_tensor_batch["sample_id"])
+    np.testing.assert_array_equal(chunked.non_tensor_batch["answer"], full.non_tensor_batch["answer"])
+    for source, target in zip(full.non_tensor_batch["multi_modal_inputs"], chunked.non_tensor_batch["multi_modal_inputs"]):
+        for key in source:
+            torch.testing.assert_close(source[key], target[key], rtol=0, atol=0)
+
+
+def test_vllm_rollout_preserves_driver_policy_metadata():
+    import ast
+    from pathlib import Path
+
+    source = Path(__file__).parents[1] / "verl/workers/rollout/vllm_rollout/vllm_rollout_spmd.py"
+    tree = ast.parse(source.read_text(encoding="utf-8"))
+    rollout = next(
+        node for node in ast.walk(tree)
+        if isinstance(node, ast.FunctionDef) and node.name == "generate_sequences"
+    )
+    returns = [
+        node.value for node in ast.walk(rollout)
+        if isinstance(node, ast.Return) and isinstance(node.value, ast.Call)
+        and isinstance(node.value.func, ast.Name) and node.value.func.id == "DataProto"
+    ]
+    assert any(
+        keyword.arg == "meta_info"
+        and isinstance(keyword.value, ast.Attribute)
+        and isinstance(keyword.value.value, ast.Name)
+        and keyword.value.value.id == "prompts"
+        and keyword.value.attr == "meta_info"
+        for call in returns for keyword in call.keywords
+    ), "vLLM rollout must propagate policy_version metadata back to the trainer"
