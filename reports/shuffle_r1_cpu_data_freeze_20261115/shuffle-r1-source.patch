+import copy
+from pathlib import Path
+import random
+from types import SimpleNamespace
+
+import numpy as np
+import pytest
+import torch
+from torchdata.stateful_dataloader import StatefulDataLoader
+
+from shuffle_r1 import fsdp
+from shuffle_r1.checkpoint import run_identity, verify_manifest
+from shuffle_r1.config import PPOConfig
+from shuffle_r1 import ray_trainer
+from verl.protocol import DataProto
+from verl.utils.checkpoint.checkpoint_manager import find_latest_ckpt_path
+
+
+class CpuCheckpointManager:
+    """Use real CPU tensors and optimizer state with the worker's on-disk contract."""
+
+    def __init__(self):
+        self.model = torch.nn.Linear(1, 1, dtype=torch.float64)
+        self.optimizer = torch.optim.AdamW(self.model.parameters(), lr=0.04)
+        self.scheduler = torch.optim.lr_scheduler.StepLR(self.optimizer, step_size=1, gamma=0.8)
+        self.loaded = False
+
+    def update(self):
+        self.model(torch.tensor([[3.0]], dtype=torch.float64)).square().sum().backward()
+        self.optimizer.step()
+        self.optimizer.zero_grad()
+        self.scheduler.step()
+
+    def save_checkpoint(self, directory):
+        path = Path(directory)
+        torch.save(self.model.state_dict(), path / "model_world_size_1_rank_0.pt")
+        torch.save(self.optimizer.state_dict(), path / "optim_world_size_1_rank_0.pt")
+        torch.save(self.scheduler.state_dict(), path / "extra_state_world_size_1_rank_0.pt")
+
+    def load_checkpoint(self, directory):
+        path = Path(directory)
+        self.model.load_state_dict(torch.load(path / "model_world_size_1_rank_0.pt", weights_only=True))
+        self.optimizer.load_state_dict(torch.load(path / "optim_world_size_1_rank_0.pt", weights_only=True))
+        self.scheduler.load_state_dict(torch.load(path / "extra_state_world_size_1_rank_0.pt", weights_only=True))
+        self.loaded = True
+
+
+@pytest.fixture
+def checkpoint_setup(tmp_path, monkeypatch):
+    cuda_rng = torch.Generator().manual_seed(81)
+    monkeypatch.setattr(torch.cuda, "get_rng_state", cuda_rng.get_state)
+    monkeypatch.setattr(torch.cuda, "set_rng_state", cuda_rng.set_state)
+    monkeypatch.setattr(fsdp.dist, "barrier", lambda: None)
+    monkeypatch.setattr(ray_trainer, "RLHFDataset", lambda **_: list(range(48)))
+    monkeypatch.setattr(ray_trainer, "collate_fn", torch.utils.data.default_collate)
+
+    def cpu_dataloader(**kwargs):
+        return StatefulDataLoader(**{**kwargs, "num_workers": 0})
+
+    monkeypatch.setattr(ray_trainer, "StatefulDataLoader", cpu_dataloader)
+    config = PPOConfig()
+    config.trainer.n_gpus_per_node = 1
+    config.trainer.require_checkpoint_manifest = True
+    config.trainer.checkpoint_model_revision = "66285546d2b821cf421d4f5eb2576359d3770cd3"
+    config.trainer.save_checkpoint_path = str(tmp_path / "checkpoints")
+    config.trainer.save_limit = 1
+    config.data.rollout_batch_size = 16
+    config.worker.actor.global_batch_size = 16
+    config.worker.actor.purning_ratio = 0.5
+    config.worker.rollout.n = 16
+    config.data.train_files = str(tmp_path / "train.parquet")
+    config.data.val_files = str(tmp_path / "dev.parquet")
+    Path(config.data.train_files).write_bytes(b"pinned train")
+    Path(config.data.val_files).write_bytes(b"pinned dev")
+    config.deep_post_init()
+    config.validate_execution()
+
+    def make_trainer(load_path=None, *, uniform=False):
+        trainer = object.__new__(ray_trainer.RayPPOTrainer)
+        trainer.config = copy.deepcopy(config)
+        trainer.config.trainer.load_checkpoint_path = str(load_path) if load_path else None
+        if uniform:
+            trainer.config.trainer.selection_mode = "uniform"
+        trainer.checkpoint_identity = run_identity(trainer.config)
+        trainer.global_step = trainer.optimizer_steps = trainer.scheduler_steps = 0
+        trainer.use_critic = False
+        trainer.selection_rng = np.random.default_rng(trainer.config.data.seed) if uniform else None
+        trainer.tokenizer = trainer.processor = None
+        trainer._create_dataloader()
+        manager = CpuCheckpointManager()
+        worker = SimpleNamespace(
+            _is_actor=True, _is_critic=False, _is_rollout=True, _use_param_offload=False,
+            _use_optimizer_offload=False, rank=0, config=trainer.config.worker, checkpoint_manager=manager,
+            rollout_sharding_manager=SimpleNamespace(device_mesh=object(),
+                                                   gen_random_states=torch.Generator().manual_seed(31).get_state()),
+        )
+        worker.save_checkpoint = lambda path: fsdp.FSDPWorker.save_checkpoint(worker, path)
+        worker.load_checkpoint = lambda path: fsdp.FSDPWorker.load_checkpoint(worker, path)
+        trainer.actor_rollout_wg = worker
+        return trainer
+
+    return Path(config.trainer.save_checkpoint_path), make_trainer, cuda_rng
+
+
+def save_step(trainer, step):
+    trainer.global_step = trainer.optimizer_steps = trainer.scheduler_steps = step
+    trainer._save_checkpoint()
+
+
+def next_rollout(worker):
+    rng = torch.Generator().set_state(worker.rollout_sharding_manager.gen_random_states)
+    return torch.rand(8, generator=rng)
+
+
+def next_abs_indices(trainer):
+    pairs = [
+        {"adv_sum": i + 1.0, "pair_data": DataProto.from_dict(tensors={"index": torch.tensor([i, i])})}
+        for i in range(64)
+    ]
+    return trainer.experience_resampling(pairs).batch["index"]
+
+
+def test_real_worker_and_driver_round_trip_next_rng_batch_and_optimizer(checkpoint_setup):
+    root, make_trainer, cuda_rng = checkpoint_setup
+    trainer = make_trainer()
+    original_iterator = iter(trainer.train_dataloader)
+    next(original_iterator)
+    next(original_iterator)
+    before = trainer.actor_rollout_wg.checkpoint_manager
+    before.update()
+    torch.rand(11, generator=cuda_rng)
+    random.seed(14)
+    np.random.seed(17)
+    torch.manual_seed(26)
+    save_step(trainer, 1)
+    assert (root / ray_trainer.CHECKPOINT_TRACKER).read_text() == "1"
+    expected = (next(original_iterator), random.random(), next_abs_indices(trainer),
+                torch.rand(8), torch.rand(8, generator=cuda_rng), next_rollout(trainer.actor_rollout_wg))
+    before.update()
+
+    resumed = make_trainer(find_latest_ckpt_path(str(root)))
+    resumed._load_checkpoint()
+    assert (resumed.global_step, resumed.optimizer_steps, resumed.scheduler_steps) == (1, 1, 1)
+    actual = (next(iter(resumed.train_dataloader)), random.random(), next_abs_indices(resumed),
+              torch.rand(8), torch.rand(8, generator=cuda_rng), next_rollout(resumed.actor_rollout_wg))
+    for actual_draw, expected_draw in zip(actual, expected):
+        np.testing.assert_array_equal(actual_draw, expected_draw)
+    resumed_manager = resumed.actor_rollout_wg.checkpoint_manager
+    resumed_manager.update()
+    torch.testing.assert_close(resumed_manager.model.weight, before.model.weight, rtol=0, atol=0)
+    assert resumed_manager.scheduler.state_dict() == before.scheduler.state_dict()
+
+
+def test_uniform_selection_rng_resumes_independently(checkpoint_setup):
+    root, make_trainer, _ = checkpoint_setup
+    trainer = make_trainer(uniform=True)
+    draw = trainer.selection_rng.choice
+    draw(16, size=8, replace=False)
+    save_step(trainer, 1)
+    expected = draw(16, size=8, replace=False)
+    resumed = make_trainer(root / "global_step_1", uniform=True)
+    resumed._load_checkpoint()
+    np.testing.assert_array_equal(resumed.selection_rng.choice(16, size=8, replace=False), expected)
+
+
+@pytest.mark.parametrize("bad_file", ["driver_rng.pt", "actor/rollout_rng_rank_0.pt"])
+def test_strict_resume_rejects_missing_or_corrupted_files_before_loading(checkpoint_setup, bad_file):
+    root, make_trainer, _ = checkpoint_setup
+    trainer = make_trainer()
+    save_step(trainer, 1)
+    path = root / "global_step_1"
+    if bad_file == "driver_rng.pt":
+        (path / bad_file).unlink()
+    else:
+        data = (path / bad_file).read_bytes()
+        (path / bad_file).write_bytes(bytes([data[0] ^ 0xFF]) + data[1:])
+    resumed = make_trainer(path)
+    with pytest.raises(RuntimeError, match="incomplete strict checkpoint|digest or size mismatch"):
+        resumed._load_checkpoint()
+    assert not resumed.actor_rollout_wg.checkpoint_manager.loaded
+
+
+def test_identity_rejects_changed_data_before_loading(checkpoint_setup):
+    root, make_trainer, _ = checkpoint_setup
+    trainer = make_trainer()
+    save_step(trainer, 1)
+    Path(trainer.config.data.train_files).write_bytes(b"different train")
+    resumed = make_trainer(find_latest_ckpt_path(str(root)))
+    with pytest.raises(RuntimeError, match="run identity mismatch"):
+        resumed._load_checkpoint()
+    assert not resumed.actor_rollout_wg.checkpoint_manager.loaded
+
+
+def test_interruption_during_actor_save_preserves_previous_checkpoint(checkpoint_setup, monkeypatch):
+    root, make_trainer, _ = checkpoint_setup
+    trainer = make_trainer()
+    save_step(trainer, 1)
+
+    def interrupt(path):
+        Path(path, "model_world_size_1_rank_0.pt").write_bytes(b"partial")
+        raise OSError("injected actor write failure")
+
+    monkeypatch.setattr(trainer.actor_rollout_wg.checkpoint_manager, "save_checkpoint", interrupt)
+    with pytest.raises(OSError, match="injected actor write failure"):
+        save_step(trainer, 2)
+    assert (root / ray_trainer.CHECKPOINT_TRACKER).read_text() == "1"
+    assert not (root / "global_step_2").exists()
+    resumed = make_trainer(find_latest_ckpt_path(str(root)))
+    resumed._load_checkpoint()
+    assert resumed.global_step == 1
+
+
+@pytest.mark.parametrize("failure", ["directory", "tracker"])
+def test_failure_before_commit_preserves_previous_and_allows_retry(checkpoint_setup, monkeypatch, failure):
+    root, make_trainer, _ = checkpoint_setup
+    trainer = make_trainer()
+    save_step(trainer, 1)
+    replace = ray_trainer.os.replace
+
+    def interrupt(src, dst):
+        target = "global_step_2" if failure == "directory" else ray_trainer.CHECKPOINT_TRACKER
+        if Path(dst).name == target:
+            raise OSError("injected publish failure")
+        return replace(src, dst)
+
+    with monkeypatch.context() as patch:
+        patch.setattr(ray_trainer.os, "replace", interrupt)
+        with pytest.raises(OSError, match="injected publish failure"):
+            save_step(trainer, 2)
+    assert (root / ray_trainer.CHECKPOINT_TRACKER).read_text() == "1"
+    if failure == "tracker":
+        assert verify_manifest(root / "global_step_2", trainer.checkpoint_identity, 2)["optimizer_steps"] == 2
+    else:
+        assert not (root / "global_step_2").exists()
+    resumed = make_trainer(root / "global_step_1")
+    resumed._load_checkpoint()
+    assert resumed.global_step == 1
+    save_step(resumed, 2)
+    assert (root / ray_trainer.CHECKPOINT_TRACKER).read_text() == "2"
+    assert not (root / "global_step_1").exists()
+    assert not (root / ".unpublished_global_step_2").exists()
+
+
+def test_interruption_after_tracker_replace_leaves_new_checkpoint_resumable(checkpoint_setup, monkeypatch):
+    root, make_trainer, _ = checkpoint_setup
+    trainer = make_trainer()
+    save_step(trainer, 1)
+    sync_directory = ray_trainer.sync_directory
+
+    def interrupt_after_replace(path):
+        if Path(path) == root and (root / ray_trainer.CHECKPOINT_TRACKER).read_text() == "2":
+            raise OSError("injected failure after tracker replace")
+        sync_directory(path)
+
+    monkeypatch.setattr(ray_trainer, "sync_directory", interrupt_after_replace)
+    with pytest.raises(OSError, match="injected failure after tracker replace"):
+        save_step(trainer, 2)
+    assert (root / "global_step_1").exists()
+    resumed = make_trainer(find_latest_ckpt_path(str(root)))
+    resumed._load_checkpoint()
+    assert resumed.global_step == 2
