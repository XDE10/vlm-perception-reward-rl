+++ b/shuffle_r1/single_gpu.py
@@ -0,0 +1,236 @@
+"""Single-GPU logical-batch planning helpers.
+
+These helpers deliberately contain no model/runtime dependencies so that batch
+geometry and ABS feasibility can be tested on CPU before allocating a GPU.
+"""
+from dataclasses import asdict, dataclass
+import math
+
+
+@dataclass(frozen=True)
+class BatchGeometry:
+    prompts: int
+    samples_per_prompt: int
+    kept_per_prompt: int
+    candidate_rows: int
+    kept_rows: int
+    world_size: int
+    actor_batch_config: int
+    actor_batch_per_rank: int
+    kept_rows_per_rank: int
+    optimizer_steps_per_outer_step: int
+    micro_batches_per_optimizer_step: int
+    abs_pairs: int
+    abs_update_steps: int
+    abs_pairs_per_replay: int
+    replay_times: int
+    partial_actor_batch: bool
+
+    def to_dict(self):
+        return asdict(self)
+
+
+def derive_batch_geometry(
+    prompts: int,
+    actor_batch_config: int,
+    *,
+    samples_per_prompt: int = 16,
+    pruning_ratio: float = 0.5,
+    world_size: int = 1,
+    micro_batch_size: int = 1,
+    replay_times: int = 8,
+) -> BatchGeometry:
+    """Mirror FSDPWorker._init_config and Shuffle-R1 ABS sizing exactly."""
+    ints = (prompts, actor_batch_config, samples_per_prompt, world_size,
+            micro_batch_size, replay_times)
+    if any(not isinstance(x, int) or x <= 0 for x in ints):
+        raise ValueError("all batch sizes, world_size and replay_times must be positive integers")
+    if not 0.0 <= pruning_ratio < 1.0:
+        raise ValueError("pruning_ratio must be in [0, 1)")
+    kept_per_prompt_float = samples_per_prompt * (1.0 - pruning_ratio)
+    kept_per_prompt = int(kept_per_prompt_float)
+    if not math.isclose(kept_per_prompt_float, kept_per_prompt, abs_tol=1e-9):
+        raise ValueError("samples_per_prompt * (1-pruning_ratio) must be an integer")
+    if samples_per_prompt % 2:
+        raise ValueError("pairwise trajectory sampling requires an even sample count")
+    if prompts % world_size:
+        raise ValueError("prompt count must divide evenly across data-parallel ranks")
+
+    candidate_rows = prompts * samples_per_prompt
+    kept_rows = prompts * kept_per_prompt
+    if kept_rows % world_size:
+        raise ValueError("kept rows must divide evenly across data-parallel ranks")
+
+    # FSDPWorker._init_config multiplies G by n, divides by world size,
+    # then applies the same pruning ratio to the per-rank actor batch.
+    actor_batch_global = actor_batch_config * samples_per_prompt
+    if actor_batch_global % world_size:
+        raise ValueError("actor global batch must divide evenly across ranks")
+    actor_batch_per_rank = int(
+        (actor_batch_global // world_size) * (1.0 - pruning_ratio)
+    )
+    if actor_batch_per_rank <= 0 or actor_batch_per_rank % micro_batch_size:
+        raise ValueError("per-rank actor batch must be positive and divisible by micro batch")
+
+    kept_rows_per_rank = kept_rows // world_size
+    partial = kept_rows_per_rank % actor_batch_per_rank != 0
+    optimizer_steps = math.ceil(kept_rows_per_rank / actor_batch_per_rank)
+    micro_batches = actor_batch_per_rank // micro_batch_size
+
+    # ray_trainer.experience_resampling uses this separate quantity only to
+    # size each ABS draw; it is NOT the actor optimizer-step count.
+    abs_pairs = prompts * (kept_per_prompt // 2)
+    abs_update_steps_num = prompts * kept_per_prompt
+    if abs_update_steps_num % actor_batch_config:
+        raise ValueError("ABS sizing requires prompts*kept_per_prompt divisible by actor_batch_config")
+    abs_update_steps = abs_update_steps_num // actor_batch_config
+    pairs_per_replay_num = actor_batch_config * abs_update_steps
+    pairs_per_replay_den = 2 * replay_times
+    if pairs_per_replay_num % pairs_per_replay_den:
+        raise ValueError("ABS pairs per replay is not an integer under the upstream sizing rule")
+    pairs_per_replay = pairs_per_replay_num // pairs_per_replay_den
+    if abs_pairs < pairs_per_replay:
+        raise ValueError(
+            f"ABS has {abs_pairs} candidate pairs but each replay needs {pairs_per_replay}"
+        )
+
+    return BatchGeometry(
+        prompts=prompts,
+        samples_per_prompt=samples_per_prompt,
+        kept_per_prompt=kept_per_prompt,
+        candidate_rows=candidate_rows,
+        kept_rows=kept_rows,
+        world_size=world_size,
+        actor_batch_config=actor_batch_config,
+        actor_batch_per_rank=actor_batch_per_rank,
+        kept_rows_per_rank=kept_rows_per_rank,
+        optimizer_steps_per_outer_step=optimizer_steps,
+        micro_batches_per_optimizer_step=micro_batches,
+        abs_pairs=abs_pairs,
+        abs_update_steps=abs_update_steps,
+        abs_pairs_per_replay=pairs_per_replay,
+        replay_times=replay_times,
+        partial_actor_batch=partial,
+    )
+
+
+def validate_abs_support(weights, sample_size: int) -> int:
+    """Fail closed when upstream weighted no-replacement sampling is impossible."""
+    values = [float(value) for value in weights]
+    if sample_size <= 0:
+        raise ValueError("ABS sample_size must be positive")
+    if any(not math.isfinite(value) or value < 0 for value in values):
+        raise ValueError("ABS weights must be finite and non-negative")
+    if not values or sum(values) <= 0:
+        raise ValueError("ABS weights have zero total mass")
+    support = sum(value > 0 for value in values)
+    if support < sample_size:
+        raise ValueError(
+            f"ABS positive support {support} is smaller than no-replacement draw {sample_size}"
+        )
+    return support
+
+
+def reference_layout_indices(
+    total_rows: int,
+    reference_data_parallel_size: int,
+    reference_rank_rows: int,
+    optimizer_batch_per_rank: int,
+    reference_micro_batch_size: int,
+):
+    """Recreate DP_COMPUTE_PROTO rank chunks and synchronized microbatch order.
+
+    Output is grouped by optimizer step, then reference microbatch index, then
+    rank, with each reference microbatch's rows kept contiguous.
+    """
+    values = (
+        total_rows, reference_data_parallel_size, reference_rank_rows,
+        optimizer_batch_per_rank, reference_micro_batch_size,
+    )
+    if any(not isinstance(value, int) or value <= 0 for value in values):
+        raise ValueError("reference layout dimensions must be positive integers")
+    if total_rows != reference_data_parallel_size * reference_rank_rows:
+        raise ValueError("total_rows must equal reference_data_parallel_size * reference_rank_rows")
+    if reference_rank_rows % optimizer_batch_per_rank:
+        raise ValueError("reference rank rows must divide evenly into optimizer batches")
+    if optimizer_batch_per_rank % reference_micro_batch_size:
+        raise ValueError("optimizer batch must divide evenly into reference microbatches")
+
+    optimizer_steps = reference_rank_rows // optimizer_batch_per_rank
+    groups_per_rank_step = optimizer_batch_per_rank // reference_micro_batch_size
+    order = []
+    for step in range(optimizer_steps):
+        for group in range(groups_per_rank_step):
+            for rank in range(reference_data_parallel_size):
+                start = (
+                    rank * reference_rank_rows
+                    + step * optimizer_batch_per_rank
+                    + group * reference_micro_batch_size
+                )
+                order.extend(range(start, start + reference_micro_batch_size))
+    if len(order) != total_rows or len(set(order)) != total_rows:
+        raise AssertionError("reference layout must be a permutation of all rows")
+    return order
+
+
+def reference_token_weights(valid_token_counts, reference_micro_batch_size: int):
+    """Return per-row weights that reconstruct a masked mean per reference microbatch."""
+    counts = [int(value) for value in valid_token_counts]
+    if reference_micro_batch_size <= 0 or len(counts) % reference_micro_batch_size:
+        raise ValueError("token counts must divide into complete reference microbatches")
+    weights = []
+    for start in range(0, len(counts), reference_micro_batch_size):
+        group = counts[start:start + reference_micro_batch_size]
+        denominator = sum(group)
+        if denominator <= 0:
+            raise ValueError("reference microbatch has no valid response tokens")
+        weights.extend(value / denominator for value in group)
+    return weights
+
+
+def next_logical_step(current_step: int, total_steps: int):
+    """Return the next 1-based logical step, or None after the final step."""
+    if not isinstance(current_step, int) or current_step < 0:
+        raise ValueError("current_step must be a non-negative integer")
+    if not isinstance(total_steps, int) or total_steps < 0:
+        raise ValueError("total_steps must be a non-negative integer")
+    if current_step >= total_steps:
+        return None
+    return current_step + 1
+
+
+def capture_driver_rng_state():
+    """Capture RNG streams used by driver-side PTS ablations and ABS sampling."""
+    import random
+    import numpy as np
+    import torch
+
+    return {
+        "schema": 1,
+        "python": random.getstate(),
+        "numpy": np.random.get_state(),
+        "torch_cpu": torch.get_rng_state(),
+        "torch_cuda": (
+            torch.cuda.get_rng_state_all()
+            if torch.cuda.is_available() and torch.cuda.is_initialized()
+            else None
+        ),
+    }
+
+
+def restore_driver_rng_state(state):
+    """Restore a driver RNG snapshot, failing closed on incompatible devices."""
+    import random
+    import numpy as np
+    import torch
+
+    if state.get("schema") != 1:
+        raise ValueError(f"unsupported driver RNG schema: {state.get('schema')!r}")
+    random.setstate(state["python"])
+    np.random.set_state(state["numpy"])
+    torch.set_rng_state(state["torch_cpu"])
+    cuda_state = state.get("torch_cuda")
+    if cuda_state is not None:
+        if not torch.cuda.is_available():
+            raise RuntimeError("checkpoint contains CUDA RNG state but CUDA is unavailable")
+        torch.cuda.set_rng_state_all(cuda_state)
