new file mode 100644
index 0000000..265ef18
--- /dev/null
+++ b/shuffle_r1/checkpoint.py
@@ -0,0 +1,105 @@
+"""Content and run-identity checks for opt-in strict Shuffle-R1 checkpoints."""
+
+import hashlib
+import json
+import os
+from pathlib import Path
+import subprocess
+
+
+MANIFEST = "manifest.json"
+
+
+def file_digest(path, *, sync=False):
+    with path.open("rb") as stream:
+        if sync:
+            os.fsync(stream.fileno())
+        return hashlib.file_digest(stream, "sha256").hexdigest()
+
+
+def sync_directory(path):
+    fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY)
+    try:
+        os.fsync(fd)
+    finally:
+        os.close(fd)
+
+
+def run_identity(config):
+    values = config.to_dict()
+    values["trainer"].pop("save_checkpoint_path")
+    values["trainer"].pop("load_checkpoint_path")
+    config_sha = hashlib.sha256(json.dumps(values, sort_keys=True).encode()).hexdigest()
+    root = Path(__file__).resolve().parents[1]
+    commit = subprocess.run(
+        ["git", "rev-parse", "HEAD"], cwd=root, capture_output=True, text=True, check=False
+    ).stdout.strip()
+    source = hashlib.sha256()
+    for tree in ("shuffle_r1", "verl"):
+        for path in sorted((root / tree).rglob("*.py")):
+            source.update(f"{path.relative_to(root)}:{file_digest(path)}\n".encode())
+    data = {}
+    for role, location in (("train", config.data.train_files), ("dev", config.data.val_files)):
+        path = Path(location.split("@", 1)[0])
+        if not path.is_file():
+            raise ValueError(f"strict checkpoint identity requires a local {role} data file: {path}")
+        data[role] = file_digest(path)
+    return {
+        "git_commit": commit or None,
+        "source_sha256": source.hexdigest(),
+        "config_sha256": config_sha,
+        "model_revision": config.trainer.checkpoint_model_revision,
+        "data_sha256": data,
+    }
+
+
+def checkpoint_files(root, *, sync=False):
+    return {
+        path.relative_to(root).as_posix(): {"bytes": path.stat().st_size, "sha256": file_digest(path, sync=sync)}
+        for path in sorted(root.rglob("*"))
+        if path.is_file() and path != root / MANIFEST
+    }
+
+
+def validate_files(files):
+    required = {
+        "dataloader.pt", "driver_rng.pt", "actor/model_world_size_1_rank_0.pt",
+        "actor/optim_world_size_1_rank_0.pt", "actor/extra_state_world_size_1_rank_0.pt",
+        "actor/rollout_rng_rank_0.pt",
+    }
+    missing = required - files.keys()
+    if missing:
+        raise RuntimeError(f"incomplete strict checkpoint: missing {sorted(missing)}")
+
+
+def write_manifest(root, identity, step, optimizer_steps, scheduler_steps):
+    files = checkpoint_files(root, sync=True)
+    validate_files(files)
+    manifest = {"schema": 1, "identity": identity, "global_step": step,
+                "optimizer_steps": optimizer_steps, "scheduler_steps": scheduler_steps, "files": files}
+    with (root / MANIFEST).open("w", encoding="utf-8") as stream:
+        json.dump(manifest, stream, indent=2, sort_keys=True)
+        stream.write("\n")
+        stream.flush()
+        os.fsync(stream.fileno())
+    for path in reversed(sorted(subdir for subdir in root.rglob("*") if subdir.is_dir())):
+        sync_directory(path)
+    sync_directory(root)
+
+
+def verify_manifest(root, identity, expected_step):
+    with (root / MANIFEST).open(encoding="utf-8") as stream:
+        manifest = json.load(stream)
+    if manifest.get("schema") != 1 or manifest.get("global_step") != expected_step:
+        raise RuntimeError("checkpoint manifest schema or logical step mismatch")
+    if manifest.get("identity") != identity:
+        raise RuntimeError("checkpoint run identity mismatch")
+    for name in ("optimizer_steps", "scheduler_steps"):
+        count = manifest.get(name)
+        if type(count) is not int or count < 0:
+            raise RuntimeError(f"invalid checkpoint {name}")
+    files = checkpoint_files(root)
+    validate_files(files)
+    if manifest.get("files") != files:
+        raise RuntimeError("checkpoint file digest or size mismatch")
+    return manifest
